APP_NAME="Plaxtilineas Backend"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=America/Bogota
APP_URL=https://plaxtilineas.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Configuración de Base de Datos ──────────────────────────────────────────
# Para desarrollo local y tests rápidos:
DB_CONNECTION=sqlite
# DB_DATABASE se resuelve por defecto a database/database.sqlite

# Para producción (Hostinger MySQL):
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=u123456789_plaxtilineas
# DB_USERNAME=u123456789_user
# DB_PASSWORD=tu_password_aqui

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=plaxtilineas_cache

# ─── Correo SMTP (Hostinger / Producción) ──────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="info@plaxtilineas.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Frontend & CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=https://plaxtilineas.com

# ─── Pasarela de Pago Wompi ───────────────────────────────────────────────────
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_KEY=prod_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_KEY=prod_events_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_BASE_URL=https://production.wompi.co/v1

# ─── Almacenamiento Multimedia Cloudinary ─────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── IA Groq (Asistente Mateo y Dashboard) ────────────────────────────────────
GROQ_API_KEY=
GROQ_API_KEY_DASHBOARD=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ─── Autenticación Social Google ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ─── Reglas de Negocio ────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@plaxtilineas.com
IVA_PORCENTAJE=0.0
COSTO_ENVIO_COP=10000.0

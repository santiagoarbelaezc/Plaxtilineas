# ─── Base de datos principal (Plaxtilineas) ──────────────────────────────────
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# ─── Base de datos catálogo (importación) ────────────────────────────────────
HOSTINGER_DB_HOST=
HOSTINGER_DB_PORT=3306
HOSTINGER_DB_USER=
HOSTINGER_DB_PASSWORD=
HOSTINGER_DB_NAME=

# ─── Seguridad (tokens HMAC-SHA256) ──────────────────────────────────────────
TOKEN_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria
TOKEN_EXPIRATION=3600

# ─── Cloudinary ──────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Email SMTP (Gmail) ───────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=Mi Empresa
SUPPORT_EMAIL=

# ─── Empresa ──────────────────────────────────────────────────────────────────
COMPANY_NAME=Mi Empresa SAS
COMPANY_PHONE_1=
COMPANY_PHONE_2=
COMPANY_ADDRESS=

# ─── App ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://mi-dominio.com
APP_ENV=production

# ─── Wompi (Pasarela de Pago) ────────────────────────────────────────────────
# Obtener desde: https://comercios.wompi.co → Llaves del API
# Sandbox: pub_test_... / prv_test_...  |  Producción: pub_prod_... / prv_prod_...
WOMPI_PUBLIC_KEY=pub_test_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_KEY=test_integrity_XXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_EVENTS_KEY=test_events_XXXXXXXXXXXXXXXXXXXXXXXX
